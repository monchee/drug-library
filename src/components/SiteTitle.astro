---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <div class="scratch-brand">
    <span class="scratch-brand-name" translate="no">SCRATCH</span>
    <span class="scratch-brand-subtitle">Skin & Challenge Reference for Allergy Testing Clinical Handbook</span>
  </div>
</a>

<style>
  .site-title {
    align-items: center;
    text-decoration: none;
    color: #ffffff !important;
    white-space: nowrap;
  }
  .scratch-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    line-height: 1.15;
  }
  .scratch-brand-name {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #ffffff;
  }
  .scratch-brand-subtitle {
    font-size: 0.62rem;
    font-weight: 400;
    opacity: 0.85;
    color: #ffffff;
    white-space: normal;
    max-width: 280px;
    line-height: 1.15;
  }
  @media (min-width: 50rem) {
    .scratch-brand-subtitle {
      white-space: nowrap;
      max-width: none;
    }
  }
</style>
